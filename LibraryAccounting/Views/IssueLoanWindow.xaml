<Window x:Class="LibraryAccounting.Views.IssueLoanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Height="600" Width="940"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource CardBrush}"
                Padding="16" CornerRadius="4"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Читатель"
                           FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>

                <Border DockPanel.Dock="Top" Background="{StaticResource PageBrush}"
                        Padding="10" Margin="0,0,0,12" CornerRadius="4">
                    <StackPanel>
                        <TextBlock x:Name="SelectedReaderText"
                                   Text="{Binding SelectedReader.DisplayName}"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding SelectedReader.Status}"
                                   Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <Button DockPanel.Dock="Right" Content="Найти"
                            Command="{Binding ReaderSearchCommand}" Margin="8,0,0,0"/>
                    <TextBox Text="{Binding ReaderSearch, UpdateSourceTrigger=PropertyChanged}"/>
                </DockPanel>

                <ListBox ItemsSource="{Binding Readers}"
                         SelectedItem="{Binding SelectedReader}"
                         DisplayMemberPath="DisplayName"/>
            </DockPanel>
        </Border>

        <Border Grid.Column="2" Background="{StaticResource CardBrush}"
                Padding="16" CornerRadius="4"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Экземпляр и форма выдачи"
                           FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>

                <Button DockPanel.Dock="Bottom" Content="Оформить выдачу"
                        Click="OnIssueClick" MinWidth="180"
                        HorizontalAlignment="Left" Margin="0,14,0,0"/>

                <StackPanel>
                    <TextBlock Text="Инвентарный номер экземпляра"/>
                    <ComboBox ItemsSource="{Binding Copies}"
                              SelectedItem="{Binding SelectedCopy}"
                              DisplayMemberPath="Display"
                              Margin="0,6,0,14"/>

                    <TextBlock Text="Форма выдачи"/>
                    <ComboBox ItemsSource="{Binding Forms}"
                              SelectedItem="{Binding SelectedForm}"
                              DisplayMemberPath="Name"
                              Margin="0,6,0,14"/>

                    <Border Background="{StaticResource PageBrush}" Padding="10" CornerRadius="4">
                        <TextBlock Text="{Binding DueDateInfo}"/>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>