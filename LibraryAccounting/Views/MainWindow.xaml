<Window x:Class="LibraryAccounting.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Учёт книжного фонда библиотеки"
        Height="740" Width="1220"
        WindowStartupLocation="CenterScreen">
    <DockPanel>

        <Border DockPanel.Dock="Top" Background="{StaticResource AccentBrush}" Padding="16,10">
            <DockPanel>
                <TextBlock Text="Учёт книжного фонда библиотеки"
                           Foreground="White" FontSize="16" FontWeight="Bold"/>
                <TextBlock DockPanel.Dock="Right"
                           Text="{Binding CurrentUserInfo}"
                           Foreground="#CCFBF1" FontSize="13"
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{StaticResource LineBrush}" Padding="16,6">
            <TextBlock Text="Сервер: localhost\SQLEXPRESS • База данных: LibraryDb • MS SQL Server Express • Entity Framework Core 8.0"
                       Foreground="{StaticResource MutedBrush}" FontSize="11"/>
        </Border>

        <TabControl Margin="12,10,12,10">

            <TabItem Header="Электронный каталог">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{StaticResource CardBrush}"
                            Padding="12" Margin="0,0,0,10" CornerRadius="4"
                            BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Выдать книгу"
                                    Click="OnIssueClick" Margin="12,0,0,0"/>
                            <Button DockPanel.Dock="Right" Content="Найти"
                                    Command="{Binding SearchCommand}" Margin="12,0,0,0"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Поиск:" VerticalAlignment="Center"/>
                                <TextBox Width="280" Margin="8,0,12,0"
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="Жанр:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox Width="200"
                                          ItemsSource="{Binding Genres}"
                                          SelectedItem="{Binding SelectedGenre}"
                                          DisplayMemberPath="Name"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <DataGrid ItemsSource="{Binding CatalogRows}"
                              SelectedItem="{Binding SelectedCatalogRow}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Название" Binding="{Binding Title}" Width="300"/>
                            <DataGridTextColumn Header="Авторы" Binding="{Binding Authors}" Width="180"/>
                            <DataGridTextColumn Header="Жанр" Binding="{Binding Genre}" Width="140"/>
                            <DataGridTextColumn Header="Издательство" Binding="{Binding Publisher}" Width="150"/>
                            <DataGridTextColumn Header="Год" Binding="{Binding Year}" Width="70"/>
                            <DataGridTextColumn Header="Доступно экземпляров"
                                                Binding="{Binding Availability}" Width="160"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Выдачи">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{StaticResource CardBrush}"
                            Padding="12" Margin="0,0,0,10" CornerRadius="4"
                            BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Оформить возврат" Click="OnReturnClick" MinWidth="160"/>
                            <Button Content="Продлить срок" Click="OnExtendClick" MinWidth="150" Margin="12,0,0,0"/>
                            <Button Content="Обновить" Command="{Binding RefreshLoansCommand}"
                                    MinWidth="110" Margin="12,0,0,0" Background="#64748B"/>
                        </StackPanel>
                    </Border>

                    <DataGrid ItemsSource="{Binding LoanRows}"
                              SelectedItem="{Binding SelectedLoanRow}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Инв. номер"
                                                Binding="{Binding InventoryNumber}" Width="110"/>
                            <DataGridTextColumn Header="Книга" Binding="{Binding Title}" Width="300"/>
                            <DataGridTextColumn Header="Читатель" Binding="{Binding ReaderName}" Width="230"/>
                            <DataGridTextColumn Header="Дата выдачи" Binding="{Binding IssueDate}" Width="110"/>
                            <DataGridTextColumn Header="Срок возврата" Binding="{Binding DueDate}" Width="120"/>
                            <DataGridTextColumn Header="Форма" Binding="{Binding FormName}" Width="130"/>
                            <DataGridTextColumn Header="Статус" Binding="{Binding StatusText}" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>